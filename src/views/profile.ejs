<%- include('partials/head', { title: 'Mi cuenta', bodyClass: 'app-page' }) %>
<%- include('partials/navbar') %>

<div id="app" style="display: none;">

    <%- include('partials/banner', { title: 'Mi cuenta', subtitle: 'Revisa y edita los datos de tu perfil de jugador.' }) %>

    <div class="container page-container">
        <div class="row">

            <!-- Tarjeta del jugador -->
            <div class="col s12 m4">
                <div class="card player-card">
                    <div class="card-content">
                        <img id="avatar" class="avatar" alt="Foto de perfil" style="display: none;">
                        <div class="player-avatar" id="playerAvatar">?</div>
                        <p class="player-name" id="playerName">Jugador</p>
                        <span class="badge-role" id="playerRole">user</span>
                        <p class="player-level" id="playerLevel"></p>
                    </div>
                </div>
            </div>

            <!-- Formulario -->
            <div class="col s12 m8">
                <div class="card">
                    <div class="card-content">
                        <span class="card-title">Mis datos</span>

                        <form id="profileForm" novalidate>
                            <div class="row">
                                <div class="input-field col s12 m6">
                                    <input id="email" type="text" disabled>
                                    <label for="email">Email (no editable)</label>
                                </div>
                                <div class="input-field col s12 m6">
                                    <input id="age" type="text" disabled>
                                    <label for="age">Edad (calculada)</label>
                                </div>
                            </div>

                            <div class="row">
                                <div class="input-field col s12 m6">
                                    <input id="name" type="text" required>
                                    <label for="name">Nombre</label>
                                </div>
                                <div class="input-field col s12 m6">
                                    <input id="lastName" type="text" required>
                                    <label for="lastName">Apellido</label>
                                </div>
                            </div>

                            <div class="row">
                                <div class="input-field col s12 m6">
                                    <input id="phoneNumber" type="tel" required>
                                    <label for="phoneNumber">Teléfono</label>
                                </div>
                                <div class="input-field col s12 m6">
                                    <input id="birthdate" type="date" required>
                                    <label for="birthdate" class="active">Fecha de nacimiento</label>
                                </div>
                            </div>

                            <div class="row">
                                <div class="input-field col s12">
                                    <input id="address" type="text">
                                    <label for="address">Dirección</label>
                                </div>
                            </div>

                            <div class="row">
                                <div class="input-field col s12">
                                    <input id="url_profile" type="text">
                                    <label for="url_profile">URL de foto de perfil</label>
                                </div>
                            </div>

                            <button class="btn waves-effect waves-light full-width" type="submit">Guardar cambios</button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="site-footer">Pixel Realm &middot; Proyecto de laboratorio &middot; Express + MongoDB + JWT</div>
</div>

<%- include('partials/scripts') %>
<script>
    function showInitial(u) {
        document.getElementById('avatar').style.display = 'none';
        const initial = document.getElementById('playerAvatar');
        initial.style.display = 'flex';
        initial.textContent = (u.name || '?').charAt(0).toUpperCase();
    }

    function fillForm(u) {
        document.getElementById('email').value = u.email;
        document.getElementById('age').value = `${u.age} años`;
        document.getElementById('name').value = u.name || '';
        document.getElementById('lastName').value = u.lastName || '';
        document.getElementById('phoneNumber').value = u.phoneNumber || '';
        document.getElementById('birthdate').value = u.birthdate ? new Date(u.birthdate).toISOString().split('T')[0] : '';
        document.getElementById('address').value = u.address || '';
        document.getElementById('url_profile').value = u.url_profile || '';

        // Tarjeta del jugador
        document.getElementById('playerName').textContent = `${u.name} ${u.lastName}`;
        document.getElementById('playerRole').textContent = u.roles.join(', ');
        document.getElementById('playerLevel').textContent = `Nivel ${u.age}`;

        const avatar = document.getElementById('avatar');
        if (u.url_profile) {
            avatar.onerror = () => showInitial(u);
            avatar.onload = () => {
                avatar.style.display = 'block';
                document.getElementById('playerAvatar').style.display = 'none';
            };
            avatar.src = u.url_profile;
        } else {
            showInitial(u);
        }

        M.updateTextFields();
    }

    async function load() {
        try {
            const u = await apiFetch('/api/users/me');
            fillForm(u);
        } catch (err) {
            M.toast({ html: err.message, classes: 'red' });
        }
    }

    document.getElementById('birthdate').max = new Date().toISOString().split('T')[0];

    document.getElementById('profileForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const data = {
            name: document.getElementById('name').value.trim(),
            lastName: document.getElementById('lastName').value.trim(),
            phoneNumber: document.getElementById('phoneNumber').value.trim(),
            birthdate: document.getElementById('birthdate').value,
            address: document.getElementById('address').value.trim(),
            url_profile: document.getElementById('url_profile').value.trim()
        };

        if (!data.name || !data.lastName || !data.phoneNumber || !data.birthdate) {
            M.toast({ html: 'Nombre, apellido, teléfono y fecha de nacimiento son requeridos', classes: 'red' });
            return;
        }

        try {
            const u = await apiFetch('/api/users/me', {
                method: 'PUT',
                body: JSON.stringify(data)
            });
            fillForm(u);
            M.toast({ html: 'Datos actualizados', classes: 'green' });
        } catch (err) {
            M.toast({ html: err.message, classes: 'red' });
        }
    });

    if (requireAuth(['user', 'admin'])) {
        document.getElementById('app').style.display = 'block';
        load();
    }
</script>
</body>
</html>